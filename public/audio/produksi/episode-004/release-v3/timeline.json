      "text": "Tapi laporan sudah bilang makanan"
    },
    {
      "cue_id": "n4",
      "role": "narrator",
      "start": 68.562,
      "end": 69.636,
      "text": "dibagikan."
    },
    {
      "cue_id": "n5",
      "role": "narrator",
      "start": 72.1,
      "end": 74.578,
      "text": "Besok warga periksa yang mana dulu:"
    },
    {
      "cue_id": "n5",
      "role": "narrator",
      "start": 74.871,
      "end": 77.719,
      "text": "nota pembelian koperasi, atau laporan"
    },
    {
      "cue_id": "n5",
      "role": "narrator",
      "start": 77.719,
      "end": 81.423,
      "text": "porsi dapur? Tulis NOTA atau LAPORAN,"
    },
    {
      "cue_id": "n5",
      "role": "narrator",
      "start": 81.65,
      "end": 84.502,
      "text": "tambah satu bukti yang wajib diumumkan."
    },
    {
      "cue_id": "n5",
      "role": "narrator",
      "start": 85.246,
      "end": 88.098,
      "text": "Follow, kita buka berkasnya."
