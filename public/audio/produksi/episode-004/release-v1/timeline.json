          "text": "menentukan",
          "start": 8.852,
          "duration": 0.593
        },
        {
          "text": "inspeksi",
          "start": 9.444,
          "duration": 0.812
        },
        {
          "text": "Day",
          "start": 10.256,
          "duration": 0.322
        },
        {
          "text": "4",
          "start": 10.578,
          "duration": 0.528
        }
      ]
    }
  ],
  "captions": [
    {
      "cue_id": "01",
      "role": "gufron",
      "start": 0.313,
      "end": 3.4,
      "text": "Makanannya mana? Yang dikirim cuma"
    },
    {
      "cue_id": "01",
      "role": "gufron",
      "start": 3.4,
      "end": 3.845,
      "text": "pita?"
    },
    {
      "cue_id": "03",
      "role": "bu_warung",
      "start": 5.19,
      "end": 6.732,
      "text": "Usulan warga terbanyak:"
    },
    {
      "cue_id": "03",
      "role": "bu_warung",
      "start": 6.894,
      "end": 8.399,
      "text": "Pak Prabowow Subiyoyo!"
    },
    {
      "cue_id": "02",
      "role": "narrator",
      "start": 9.75,
      "end": 12.624,
      "text": "Baru terpilih, jadwal gunting pita"
    },
    {
      "cue_id": "02",
      "role": "narrator",
      "start": 12.624,
      "end": 13.955,
      "text": "sudah menunggu."
    },
    {
      "cue_id": "04",
      "role": "tedi",
      "start": 15.119,
      "end": 17.182,
      "text": "Pak, jam sepuluh gunting pita dua"
    },
    {
      "cue_id": "04",
      "role": "tedi",
      "start": 17.182,
      "end": 17.774,
      "text": "gedung."
    },
    {
      "cue_id": "05",
      "role": "prabowow",
      "start": 18.85,
      "end": 22.197,
      "text": "Tunggu. Program Kuliner Indonesia"
    },
    {
      "cue_id": "05",
      "role": "prabowow",
      "start": 22.197,
      "end": 25.682,
      "text": "dulu. Dapur masak, makanan sampai"
    },
    {
      "cue_id": "05",
      "role": "prabowow",
      "start": 25.682,
      "end": 27.912,
      "text": "ke warga, bahan dibeli dari petani"
    },
    {
      "cue_id": "05",
      "role": "prabowow",
      "start": 27.912,
      "end": 28.572,
      "text": "sini."
    },
    {
      "cue_id": "06",
      "role": "prabowow",
      "start": 30.1,
      "end": 31.769,
      "text": "Lalu koperasi desa."
    },
    {
      "cue_id": "06",
      "role": "prabowow",
      "start": 32.61,
      "end": 35.053,
      "text": "Hasil kebun warga masuk rak, harganya"
    },
    {
      "cue_id": "06",
      "role": "prabowow",
      "start": 35.053,
      "end": 37.673,
      "text": "jelas, untungnya kembali ke anggota."
    },
    {
      "cue_id": "06",
      "role": "prabowow",
      "start": 38.503,
      "end": 40.47,
      "text": "Begitu baru namanya program."
    },
    {
      "cue_id": "07",
      "role": "gufron",
      "start": 42.113,
      "end": 43.932,
      "text": "Pak, gedungnya siap difoto."
    },
    {
      "cue_id": "07",
      "role": "gufron",
      "start": 44.862,
      "end": 46.983,
      "text": "Kotak saya dari tadi masih kosong."
    },
    {
      "cue_id": "08",
      "role": "dadan",
      "start": 48.33,
      "end": 49.74,
      "text": "Bahannya belum masuk."
    },
    {
      "cue_id": "09",
      "role": "mas_daro",
      "start": 50.8,
      "end": 52.195,
      "text": "Truknya belum lewat."
    },
    {
      "cue_id": "10",
      "role": "bu_warung",
      "start": 54.148,
      "end": 56.413,
      "text": "Satu lubang bikin dua program macet."
    },
    {
      "cue_id": "10",
      "role": "bu_warung",
      "start": 57.199,
      "end": 59.353,
      "text": "Ini jalan yang kemarin diresmikan."
    },
    {
      "cue_id": "11",
      "role": "gufron",
      "start": 60.838,
      "end": 63.138,
      "text": "Saya sudah bilang, pita dulu, jalan"
    },
    {
      "cue_id": "11",
      "role": "gufron",
      "start": 63.138,
      "end": 63.858,
      "text": "belakangan."
    },
    {
      "cue_id": "12",
      "role": "prabowow",
      "start": 66.2,
      "end": 69.561,
      "text": "Cukup jogetnya. Jangan gunting pita"
    },
    {
      "cue_id": "12",
      "role": "prabowow",
      "start": 69.561,
      "end": 73.702,
      "text": "dulu. Buka jalan itu, periksa dapurnya,"
    },
    {
      "cue_id": "12",
      "role": "prabowow",
      "start": 73.838,
      "end": 75.677,
      "text": "isi raknya dengan barang warga."
    },
    {
      "cue_id": "12",
      "role": "prabowow",
      "start": 76.509,
      "end": 77.901,
      "text": "Saya mau lihat yang sampai ke"
    },
    {
      "cue_id": "12",
      "role": "prabowow",
      "start": 77.901,
      "end": 80.464,
      "text": "warga, bukan cuma papan namanya."
    },
    {
      "cue_id": "13",
      "role": "gufron",
      "start": 84.613,
      "end": 86.72,
      "text": "Kalau besok kotak ini harus terisi,"
    },
    {
      "cue_id": "13",
      "role": "gufron",
      "start": 86.812,
      "end": 88.207,
      "text": "kita cek yang mana dulu:"
    },
    {
      "cue_id": "13",
      "role": "gufron",
      "start": 88.362,
      "end": 90.75,
      "text": "dapurnya, atau koperasi yang kirim"
    },
    {
      "cue_id": "13",
      "role": "gufron",
      "start": 90.75,
      "end": 91.295,
      "text": "bahan?"
    },
    {
      "cue_id": "14",
      "role": "narrator",
      "start": 93.1,
      "end": 95.935,
      "text": "Tulis KULINER atau KOPDES, tambah"
    },
    {
      "cue_id": "14",
      "role": "narrator",
      "start": 95.935,
      "end": 97.408,
      "text": "satu syarat wajib."
    },
    {
      "cue_id": "14",
      "role": "narrator",
      "start": 98.153,
      "end": 100.077,
      "text": "Follow jadi warga."
    },
    {
      "cue_id": "14",
      "role": "narrator",
      "start": 100.821,
      "end": 103.256,
      "text": "Pilihan kalian menentukan inspeksi"
    },
    {
      "cue_id": "14",
      "role": "narrator",
      "start": 103.256,
      "end": 104.226,
      "text": "Day 4."
    }
  ]
}