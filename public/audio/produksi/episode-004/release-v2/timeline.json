      "role": "narrator",
      "start": 46.687,
      "end": 50.527,
      "text": "diisi. Harga beli hasil petani juga"
    },
    {
      "cue_id": "n4",
      "role": "narrator",
      "start": 50.527,
      "end": 51.33,
      "text": "kosong."
    },
    {
      "cue_id": "w1",
      "role": "bu_warung",
      "start": 52.507,
      "end": 53.609,
      "text": "Berkasnya sudah dicek?"
    },
    {
      "cue_id": "t2",
      "role": "tedi",
      "start": 53.9,
      "end": 55.565,
      "text": "Belum ditulis, Bu."
    },
    {
      "cue_id": "t2",
      "role": "tedi",
      "start": 56.231,
      "end": 58.451,
      "text": "Geser dulu, Bapak masuk foto."
    },
    {
      "cue_id": "n5",
      "role": "narrator",
      "start": 59.5,
      "end": 61.102,
      "text": "Dua foto jadi."
    },
    {
      "cue_id": "n5",
      "role": "narrator",
      "start": 61.847,
      "end": 64.183,
      "text": "Dua pertanyaan belum dijawab."
    },
    {
      "cue_id": "n5",
      "role": "narrator",
      "start": 64.927,
      "end": 67.685,
      "text": "Gufron masih pegang pita, petani"
    },
    {
      "cue_id": "n5",
      "role": "narrator",
      "start": 67.685,
      "end": 69.634,
      "text": "masih pegang hasil panen."
    },
    {
      "cue_id": "n6",
      "role": "narrator",
      "start": 70.8,
      "end": 73.123,
      "text": "Yang kenyang cuma galeri foto."
    },
    {
      "cue_id": "n7",
      "role": "narrator",
      "start": 74.3,
      "end": 76.662,
      "text": "Besok kita buka yang mana dulu:"
    },
    {
      "cue_id": "n7",
      "role": "narrator",
      "start": 76.916,
      "end": 80.283,
      "text": "surat dapur, atau buku belanja koperasi?"
    },
    {
      "cue_id": "n7",
      "role": "narrator",
      "start": 81.028,
      "end": 84.134,
      "text": "Tulis DAPUR atau KOPDES, lalu satu"
    },
    {
      "cue_id": "n7",
      "role": "narrator",
      "start": 84.134,
      "end": 86.51,
      "text": "bukti yang wajib mereka tunjukkan."
    },
    {
      "cue_id": "n7",
      "role": "narrator",
      "start": 87.253,
      "end": 90.113,
      "text": "Follow, biar pertanyaan warga tidak"
    },
    {
      "cue_id": "n7",
      "role": "narrator",
      "start": 90.113,
      "end": 91.238,
      "text": "ikut ditutup."
    }
